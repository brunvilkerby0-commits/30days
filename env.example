# TELEGRAM BOT
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here_replace_with_real_token

# FIREBASE CONFIGURATION
# Get these from Firebase Project Settings → Service Accounts
FIREBASE_API_KEY=your_firebase_api_key_here_replace_this
FIREBASE_SENDER_ID=your_firebase_sender_id_replace_this
FIREBASE_APP_ID=your_firebase_app_id_replace_this

# FIREBASE PRIVATE KEY (KEEP SECURE!)
# Copy entire JSON from Firebase Service Account
FIREBASE_KEY={"type":"service_account","project_id":"days-51e9b","private_key_id":"your_id_here","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"your_email@your_project.iam.gserviceaccount.com","client_id":"your_client_id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"your_cert_url"}

# MORALIS API KEY
# Get from https://admin.moralis.io
MORALIS_API_KEY=your_moralis_api_key_here_replace_this

# TRONGRID API KEY
# Get from https://www.trongrid.io
TRONGRID_API_KEY=your_trongrid_api_key_here_replace_this

# WALLET ADDRESSES
# These are the addresses that receive deposits
BEP20_WALLET=0xyour_bep20_wallet_address_here
TRC20_WALLET=Tyour_trc20_wallet_address_here

# API CONFIGURATION
API_PORT=3000
API_HOST=http://localhost:3000

# DATABASE
FIREBASE_DB_URL=https://your-project.firebaseio.com

# ENVIRONMENT
NODE_ENV=production
